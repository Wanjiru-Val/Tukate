# Website settings. Copy to .env.local for local work; set the same names in your host's dashboard.

# Server-only. Lets the venue form save to the database. NEVER expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public. Address of the deployed web app, e.g. https://app.tukate.co.ke
NEXT_PUBLIC_WEB_APP_URL=
# Public. Shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=
